# Copy to .env and fill in. The values below are safe defaults for LOCAL
# development only. Before deploying to a public URL you MUST replace every
# value marked "CHANGE ME" with a strong, unique secret, e.g.:
#   openssl rand -hex 32

# --- Secrets (CHANGE ME for production) ---
POSTGRES_PASSWORD=appsecret
SCANNER_TOKEN=changeme-dev-scanner-token

# --- Database ---
POSTGRES_DB=stundenplan
POSTGRES_USER=app

# --- Frontend / API ---
# Baked into the frontend bundle at build time; "/api" lets nginx proxy to the backend.
VITE_API_URL=/api
# Comma-separated allowed CORS origins for the backend API. Leave empty to reflect
# the request origin. In production set this to your public site, e.g.
# CORS_ORIGIN=https://semesti.plani.dev
CORS_ORIGIN=
# Max API requests per minute per client IP (scanner ingest is exempt).
RATE_LIMIT_PER_MINUTE=120

# Local `npm run dev` only (ignored by the production nginx/Docker build):
API_PROXY_TARGET=http://backend:4000
ALLOWED_HOSTS=semesti.plani.dev

# --- Cloudflare Tunnel ---
CF_TUNNEL_TOKEN=

# --- Scanner ---
# The dedicated scanner service fills an empty catalogue on boot, so the backend's
# own auto-start is off by default. Set to true only if you run the backend without
# the scanner service.
AUTO_START_SCANNER_ON_EMPTY_DB=false
TUCAN_START_URL=https://www.tucan.tu-darmstadt.de/scripts/mgrqispi.dll?APPNAME=CampusNet&PRGNAME=EXTERNALPAGES&ARGUMENTS=-N000000000000001,-N000344,-Awelcome
TUCAN_RATE_LIMIT_MS=750
SCAN_INTERVAL_HOURS=24
TUCAN_FACULTY_PREFIX=FB20 - Informatik
SCAN_BATCH_SIZE=10
MODULE_HANDBOOK_OVERVIEW_URL=https://www.informatik.tu-darmstadt.de/studium_fb20/im_studium/formulare_und_dokumente/ordnungen/index.de.jsp
EXAM_PLAN_OVERVIEW_URL=https://www.intern.tu-darmstadt.de/verwaltung/dez_ii/campusmanagement/cm_lvm/pruefungstermine_zentral/index.de.jsp
